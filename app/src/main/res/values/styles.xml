<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:alertDialogTheme">@style/SecondaryDialog</item>
        <item name="android:datePickerDialogTheme">@style/SecondaryDialog</item>
        <item name="android:timePickerDialogTheme">@style/SecondaryDialog</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="SecondaryPicker" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:datePickerStyle">@style/SoftDatePicker</item>
    </style>
    <style name="SoftDatePicker" parent="android:style/Widget.Material.Light.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:spinnersShown">true</item>
        <item name="android:headerBackground">@drawable/date_header</item>
        <item name="android:headerMonthTextAppearance">@style/DateHeaderText</item>
        <item name="android:headerDayOfMonthTextAppearance">@style/DateHeaderText</item>
        <item name="android:headerYearTextAppearance">@style/DateHeaderText</item>
    </style>
    <style name="DateHeaderText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/date_header_text</item>
    </style>
    <style name="SecondaryDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.16</item>
        <item name="android:windowAnimationStyle">@style/CenterPopupMotion</item>
        <item name="android:windowElevation">0dp</item>
    </style>
    <style name="TaskTimePickerTheme" parent="SecondaryDialog">
        <item name="android:timePickerStyle">@style/TaskSpinnerTimePicker</item>
    </style>
    <style name="TaskSpinnerTimePicker" parent="android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>
</resources>
