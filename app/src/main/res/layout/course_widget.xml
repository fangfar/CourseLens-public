<FrameLayout android:id="@+id/widget_refresh" android:focusable="true" android:contentDescription="@string/widget_refresh" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="6dp">
  <LinearLayout android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/widget_date" android:paddingStart="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#172132" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
   <TextView android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_label" android:textSize="10sp" android:textColor="#52627B" android:maxLines="1" android:ellipsize="end" />
   </LinearLayout>
   <ImageView android:id="@+id/widget_sync_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_sync" android:padding="3dp" android:importantForAccessibility="no" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"  android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_course_background" android:paddingStart="8dp" android:paddingEnd="8dp" android:focusable="true">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textColor="#172132" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:padding="5dp" android:text="@string/widget_next" android:textSize="11sp" android:textColor="#188466" android:background="@drawable/widget_status_background" android:visibility="gone" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_time" android:textColor="#6D7B8F" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_room" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_preview_room" android:textColor="#6D7B8F" android:textSize="12sp" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_content_second" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_course_background" android:paddingStart="8dp" android:paddingEnd="8dp" android:focusable="true">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:id="@+id/widget_title_second" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textColor="#172132" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status_second" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:padding="5dp" android:text="@string/widget_next" android:textSize="11sp" android:textColor="#188466" android:background="@drawable/widget_status_background" android:visibility="gone" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_time_second" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_time" android:textColor="#6D7B8F" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_room_second" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_preview_room" android:textColor="#6D7B8F" android:textSize="12sp" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_content_third" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_course_background" android:paddingStart="8dp" android:paddingEnd="8dp" android:focusable="true" android:visibility="gone">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:id="@+id/widget_title_third" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textColor="#172132" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status_third" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:padding="5dp" android:text="@string/widget_next" android:textSize="11sp" android:textColor="#188466" android:background="@drawable/widget_status_background" android:visibility="gone" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_time_third" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_time" android:textColor="#6D7B8F" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_room_third" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_preview_room" android:textColor="#6D7B8F" android:textSize="12sp" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_content_fourth" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_course_background" android:paddingStart="8dp" android:paddingEnd="8dp" android:focusable="true" android:visibility="gone">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:id="@+id/widget_title_fourth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textColor="#172132" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status_fourth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:padding="5dp" android:text="@string/widget_next" android:textSize="11sp" android:textColor="#188466" android:background="@drawable/widget_status_background" android:visibility="gone" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_time_fourth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_preview_time" android:textColor="#6D7B8F" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_room_fourth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_preview_room" android:textColor="#6D7B8F" android:textSize="12sp" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
   </LinearLayout>
  </LinearLayout>

  <FrameLayout android:id="@+id/widget_space_one" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
  <FrameLayout android:id="@+id/widget_space_two" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:visibility="gone" />
  <LinearLayout android:id="@+id/widget_empty_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="start|top" android:padding="8dp" android:visibility="gone">
   <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#172132" android:gravity="start" android:maxLines="2" android:ellipsize="end" />
  </LinearLayout>

 </LinearLayout>
</FrameLayout>
